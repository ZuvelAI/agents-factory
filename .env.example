# Runtime configuration shared by backend and worker processes.
ENVIRONMENT=
LOG_LEVEL=
DATABASE_URL=
OPENAI_API_KEY=
REDIS_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# Base64url encoding of exactly 32 random bytes; server processes only.
APP_MASTER_KEY=
# Meta app-level secrets used only by the backend webhook boundary.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Meta Embedded Signup identifiers; no client access token belongs in this file.
META_APP_ID=
META_CONFIGURATION_ID=
META_REDIRECT_URI=
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v25.0
# Backend-only JSON map of Google product -> OAuth client configuration.
# See docs/integrations/google-workspace.md. Never commit real credentials.
GOOGLE_OAUTH_CLIENTS=
BACKEND_API_URL=
