# Runtime configuration shared by backend and worker processes.
ENVIRONMENT=
LOG_LEVEL=
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# OpenAI project key; server processes only.
OPENAI_API_KEY=
# Base64url encoding of exactly 32 random bytes; server processes only.
APP_MASTER_KEY=
# Meta app-level secrets used only by the backend webhook boundary.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Meta Embedded Signup identifiers; no client access token belongs in this file.
META_APP_ID=
META_CONFIGURATION_ID=
META_REDIRECT_URI=
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v25.0
# Optional, server-only, identical binding in backend and control-plane.
# Incomplete configuration disables reviewer access; never use NEXT_PUBLIC_.
META_REVIEW_TENANT_ID=
META_REVIEW_ACCOUNT_ID=
META_REVIEW_WABA_ID=
META_REVIEW_PHONE_NUMBER_ID=
META_REVIEW_RECIPIENT=
BACKEND_API_URL=
CONTROL_PLANE_PORT=3000
