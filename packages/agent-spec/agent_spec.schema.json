{
  "$defs": {
    "ActionPolicyOverride": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+",
          "title": "Action",
          "type": "string"
        },
        "identity_level": {
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Identity Level",
          "type": "integer"
        },
        "confirmation_required": {
          "title": "Confirmation Required",
          "type": "boolean"
        },
        "approval_required": {
          "title": "Approval Required",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "identity_level",
        "confirmation_required",
        "approval_required"
      ],
      "title": "ActionPolicyOverride",
      "type": "object"
    },
    "AgentModelConfiguration": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "gpt-5.6-luna",
          "default": "gpt-5.6-luna",
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "const": "low",
          "default": "low",
          "title": "Reasoning Effort",
          "type": "string"
        }
      },
      "title": "AgentModelConfiguration",
      "type": "object"
    },
    "AgentRuntimeLimits": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "default": 2048,
          "maximum": 16384,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 8,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "AgentRuntimeLimits",
      "type": "object"
    },
    "AgentSpecConfiguration": {
      "additionalProperties": false,
      "properties": {
        "product_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Product Version",
          "type": "string"
        },
        "persona": {
          "$ref": "#/$defs/PersonaConfiguration"
        },
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionReference"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "permitted_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Permitted Tools",
          "type": "array"
        },
        "permitted_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Permitted Actions",
          "type": "array"
        },
        "connector_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConnectorBinding"
          },
          "title": "Connector Bindings",
          "type": "array"
        },
        "action_policies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionPolicyOverride"
          },
          "title": "Action Policies",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/VersionReference"
        },
        "identity_policy": {
          "$ref": "#/$defs/VersionReference"
        },
        "approval_routes": {
          "$ref": "#/$defs/VersionReference"
        },
        "knowledge": {
          "$ref": "#/$defs/VersionedDigestReference"
        },
        "model": {
          "$ref": "#/$defs/AgentModelConfiguration"
        },
        "language": {
          "$ref": "#/$defs/LanguagePolicy"
        },
        "human_operations": {
          "$ref": "#/$defs/HumanOperationsConfiguration"
        },
        "runtime_limits": {
          "$ref": "#/$defs/AgentRuntimeLimits"
        },
        "code_digest": {
          "title": "Code Digest",
          "type": "string"
        }
      },
      "required": [
        "product_version",
        "persona",
        "policy",
        "identity_policy",
        "approval_routes",
        "knowledge",
        "human_operations",
        "code_digest"
      ],
      "title": "AgentSpecConfiguration",
      "type": "object"
    },
    "ConnectorBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "format": "uuid",
          "title": "Binding Id",
          "type": "string"
        },
        "connector": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Connector",
          "type": "string"
        },
        "connector_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Connector Version",
          "type": "string"
        },
        "operations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "binding_id",
        "connector",
        "connector_version"
      ],
      "title": "ConnectorBinding",
      "type": "object"
    },
    "HumanOperationsConfiguration": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "handoff_enabled": {
          "default": true,
          "title": "Handoff Enabled",
          "type": "boolean"
        },
        "handoff_surface_available": {
          "default": false,
          "title": "Handoff Surface Available",
          "type": "boolean"
        },
        "awaiting_human_policy": {
          "default": "SILENT",
          "enum": [
            "SILENT",
            "ACKNOWLEDGE"
          ],
          "title": "Awaiting Human Policy",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "HumanOperationsConfiguration",
      "type": "object"
    },
    "LanguagePolicy": {
      "additionalProperties": false,
      "properties": {
        "supported_locales": {
          "default": [
            "es-CO",
            "en-US"
          ],
          "items": {
            "enum": [
              "es-CO",
              "en-US"
            ],
            "type": "string"
          },
          "title": "Supported Locales",
          "type": "array"
        },
        "default_locale": {
          "default": "es-CO",
          "enum": [
            "es-CO",
            "en-US"
          ],
          "title": "Default Locale",
          "type": "string"
        }
      },
      "title": "LanguagePolicy",
      "type": "object"
    },
    "PersonaConfiguration": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "business_name": {
          "default": "Configured Business",
          "maxLength": 200,
          "minLength": 1,
          "title": "Business Name",
          "type": "string"
        },
        "instructions": {
          "maxLength": 50000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "agent_name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Name"
        },
        "tone": {
          "default": "Cercano y claro",
          "maxLength": 120,
          "minLength": 1,
          "title": "Tone",
          "type": "string"
        },
        "formality": {
          "default": "Neutral",
          "maxLength": 80,
          "minLength": 1,
          "title": "Formality",
          "type": "string"
        },
        "brand_vocabulary": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Brand Vocabulary",
          "type": "array"
        },
        "greeting": {
          "default": "\u00a1Hola! \u00bfEn qu\u00e9 puedo ayudarte?",
          "maxLength": 500,
          "minLength": 1,
          "title": "Greeting",
          "type": "string"
        }
      },
      "required": [
        "version",
        "instructions"
      ],
      "title": "PersonaConfiguration",
      "type": "object"
    },
    "VersionReference": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "VersionReference",
      "type": "object"
    },
    "VersionedDigestReference": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "title": "VersionedDigestReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "agent_instance_id": {
      "format": "uuid",
      "title": "Agent Instance Id",
      "type": "string"
    },
    "version_id": {
      "format": "uuid",
      "title": "Version Id",
      "type": "string"
    },
    "version_number": {
      "minimum": 1,
      "title": "Version Number",
      "type": "integer"
    },
    "product": {
      "const": "Agent Customer Service",
      "default": "Agent Customer Service",
      "title": "Product",
      "type": "string"
    },
    "configuration": {
      "$ref": "#/$defs/AgentSpecConfiguration"
    }
  },
  "required": [
    "tenant_id",
    "agent_instance_id",
    "version_id",
    "version_number",
    "configuration"
  ],
  "title": "AgentSpec",
  "type": "object"
}
