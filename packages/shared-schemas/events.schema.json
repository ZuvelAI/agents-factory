{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-factory.dev/schemas/events.schema.json",
  "title": "Agents Factory Observability Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "event_kind", "severity", "name", "correlation_id", "occurred_at", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "event_kind": {"enum": ["LOG", "METRIC", "TRACE", "HEALTH", "ALERT"]},
    "severity": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,99}$"},
    "trace_id": {"type": ["string", "null"], "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "conversation_id": {"type": ["string", "null"], "format": "uuid"},
    "message_id": {"type": ["string", "null"], "format": "uuid"},
    "agent_spec_id": {"type": ["string", "null"], "format": "uuid"},
    "knowledge_version_id": {"type": ["string", "null"], "format": "uuid"},
    "capability": {"type": ["string", "null"]},
    "tool_name": {"type": ["string", "null"]},
    "connector_name": {"type": ["string", "null"]},
    "action_id": {"type": ["string", "null"], "format": "uuid"},
    "approval_id": {"type": ["string", "null"], "format": "uuid"},
    "incident_id": {"type": ["string", "null"], "format": "uuid"},
    "error_code": {"type": ["string", "null"]},
    "cost_record_id": {"type": ["string", "null"], "format": "uuid"},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "metric_value": {"type": ["number", "null"]},
    "metric_unit": {"type": ["string", "null"]},
    "status": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}
