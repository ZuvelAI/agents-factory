FROM ghcr.io/astral-sh/uv:0.12.5-python3.12-trixie
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY apps/backend apps/backend
COPY workers workers
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_CACHE_DIR=/tmp/uv-cache
RUN uv sync --locked --all-packages --no-dev && useradd --uid 10001 --create-home app
ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/workspace/apps/backend/src:/workspace/workers/agent-worker/src:/workspace/workers/knowledge-worker/src:/workspace/workers/outbound-worker/src:/workspace/workers/scheduler/src
USER app
